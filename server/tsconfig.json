{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // rootDir is src/, NOT ".", so the build emits dist/index.js rather than
    // dist/src/index.js. config.ts derives SERVER_ROOT as one level up from its
    // own location, which only lands on server/ if the layout is mirrored.
    // Compiling scripts/ too would push everything down a level and break it.
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // scripts/ is intentionally excluded from the emitted build (it runs via tsx
  // in development). `npm run typecheck` still covers it — see that script.
  "include": ["src/**/*.ts"]
}
