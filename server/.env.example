# --- API ---
# Render injects PORT automatically; this is the local default.
PORT=8787
# Comma-separated allowed origins for CORS. MUST be set to the Vercel domain in
# production — EventSource is a cross-origin request from the dashboard.
# "*" is the dev default and is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

# --- Simulator ---
# Playback multiplier: 1 = one simulated hour per 1.5 s, 5 = five times faster.
SIM_SPEED=1
# Rows written instantly on a cold boot, so the dashboard opens with history
# instead of an empty chart. Matches the old frontend replay's 55% split.
SEED_ROWS=275
# Set to 1 to wipe data/live/ on boot and replay from scratch.
SIM_RESET=0

# --- Storage ---
# Where raw-sensor-data.csv + cleaned-sensor-data.csv live.
# On Render, point this at a mounted persistent disk to keep history across
# redeploys. Without a disk the files rebuild deterministically on boot.
DATA_DIR=./data/live
